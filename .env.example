# Credenciais do PostgreSQL
POSTGRES_DB='digite_aqui_seu_banco'
POSTGRES_USER='digite_aqui_seu_usuario'
POSTGRES_PASSWORD='digite_aqui_sua_senha'

# Credenciais usadas pela API Spring Boot
SPRING_DATASOURCE_USERNAME='digite_aqui_seu_usuario'
SPRING_DATASOURCE_PASSWORD='digite_aqui_sua_senha'

# Segredo JWT: substitua por uma chave aleatória longa e exclusiva
JWT_SECRET='digite_aqui_sua_chave_secreta'

# Porta da API
PORT=8080

# Diretório de upload de imagens
APP_UPLOAD_DIR=/app/uploads
